# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.cache/
cache/

# Virtual envs
.env
.venv/
venv/
ENV/
.pixi/

# Image files
*.png
*.jpg
*.jpeg
*.bmp
*.gif
*.tiff
*.webp

# NumPy / binary data files
*.npy
*.npz

# Archives
*.zip

# Zarr stores
*.zarr

# OS files
.DS_Store
Thumbs.db

# Ignore rivanna_dl directory and all its contents
rivanna_dl/
.claude
# pixi environments
.pixi/*
!.pixi/config.toml

# Local pair datasets, training runs, generated forecasts
datasets/
runs/

# Large generated deliverables and renders (rebuild with tools/build_flow_deck.sh)
analysis/**/*.pptx
analysis/**/panels/
*.gif

# Patient-level analysis outputs stay local; only analysis/README.md and the recipe JSONs are tracked
analysis/**/*.csv
analysis/**/viz/
analysis/**/aggregate.json
analysis/**/selected_patients.json
analysis/**/viz_index.json
